   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Load raw XRD data\n",
    "df = pd.read_csv(\"../data/raw/xrd_patterns.csv\")\n",
    "display(df.head())\n",
    "\n",
    "# 2. Create target directory\n",
    "os.makedirs(\"../figures/characterization\", exist_ok=True)\n",
    "\n",
    "# 3. Plot XRD Spectra\n",
    "plt.figure(figsize=(10, 6))\n",
    "offset = df[\"Intensity_700C\"].max() * 0.3\n",
    "\n",
    "plt.plot(df[\"2Theta_deg\"], df[\"Intensity_700C\"], label=\"700°C\", color=\"#1f77b4\", linewidth=1.2)\n",
    "plt.plot(df[\"2Theta_deg\"], df[\"Intensity_1100C\"] + offset, label=\"1100°C (offset)\", color=\"#d62728\", linewidth=1.2)\n",
    "\n",
    "plt.xlabel(\"2θ (degrees)\", fontsize=12)\n",
    "plt.ylabel(\"Intensity (a.u.)\", fontsize=12)\n",
    "plt.title(\"XRD Pattern & Phase Evolution\", fontsize=14, fontweight=\"bold\")\n",
    "plt.legend(frameon=True, loc=\"upper right\")\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "plt.savefig(\"../figures/characterization/xrd_phase_evolution.png\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  }
