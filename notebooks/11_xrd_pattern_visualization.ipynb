    "### Module 07 — XRD Pattern & Phase Evolution Analysis\n",
    "\n",
    "Loads raw diffraction data across thermal processing regimes ($700^\\circ\\text{C}$ vs $1100^\\circ\\text{C}$) to track crystallization and phase architecture transformations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Load raw XRD dataset\n",
    "df = pd.read_csv(\"../data/raw/xrd_patterns.csv\")\n",
    "display(df.head())\n",
    "\n",
    "# Plotting Phase Evolution\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "plt.plot(df[\"2Theta_deg\"], df[\"Intensity_700C\"], label=\"700°C\", linewidth=1.5)\n",
    "plt.plot(df[\"2Theta_deg\"], df[\"Intensity_1100C\"], label=\"1100°C\", linewidth=1.5)\n",
    "\n",
    "plt.xlabel(r\"$2\\theta$ (degrees)\")\n",
    "plt.ylabel(\"Intensity (a.u.)\")\n",
    "plt.title(\"XRD Pattern Evolution Across Thermal Spectrum\")\n",
    "plt.legend()\n",
    "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "# Save figure before show\n",
    "plt.savefig(\n",
    "    \"../figures/characterization/xrd_phase_evolution.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "plt.show()"
   ]
  }
